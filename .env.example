# Container engine: docker | podman (./manage.sh install will prompt)
CONTAINER_ENGINE=docker

TZ=America/New_York
# Host port. Kept unique across johnycsf stacks (vaultwarden 8081, nextcloud 8082)
# and >=1024 so rootless Podman can bind it. Docker users may set 80.
HTTP_PORT=8080
ALLOW_INTERNAL_REQUESTS=true
# Public URL browsers use to reach Heimdall (useful behind a reverse proxy)
APP_URL=http://localhost:8080
